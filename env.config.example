# ==========================================================
# QueryMind Environment Configuration Template
# ==========================================================
# Copy this file to env.config and add your keys, or configure
# directly in the Web UI by clicking "API Keys & Engine" in the navbar.

# 1. Google Gemini API Key
# Get your free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. OpenAI API Key & Custom Base URL (for AI Credits Platform / Relays)
# Standard OpenAI: https://api.openai.com/v1
# AI Credits Platform: Use your custom provider base URL and API key
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 3. Preferred LLM Provider: 'auto', 'gemini', 'openai', or 'semantic_engine'
# - 'auto': Uses Gemini/OpenAI if key present, else offline engine
# - 'gemini': Explicitly calls Gemini API (gemini-1.5-flash)
# - 'openai': Explicitly calls OpenAI-compatible API using OPENAI_BASE_URL (gpt-4o-mini)
# - 'semantic_engine': High-speed deterministic engine (works 100% offline with 0 keys)
LLM_PROVIDER=auto

# 4. Server Configuration
PORT=8000
HOST=0.0.0.0
